# Prisma + SQLite
DATABASE_URL="file:./prisma/dev.db"

# Optional Turso/libSQL production database. When both values are set, the app
# and seed script use Turso instead of the local SQLite file.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"